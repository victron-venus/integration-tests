{
  "repository": "victron-venus/integration-tests",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "validate.yml",
    "integration.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "local_checks": [
    "bash scripts/ci.sh"
  ],
  "notes": [
    "Targets exercise the actual in-memory compressed release archive parser and pure release identity validator. They mutate synthetic archives and metadata, checking confined payload names and digests. No target calls SSH, installs a payload, executes device commands or starts a hardware qualification.",
    "Versioned artifacts are the reviewed source suite, not a firmware or deployment. Existing ordinary application, container, dependency and CodeQL checks remain required."
  ],
  "visibility": "public",
  "single_entry_ci": true,
  "schema": 1,
  "version_file": "SOURCE_VERSION",
  "release_notes": "CHANGELOG.md",
  "artifact_pattern": "release-assets*",
  "container_assets": {},
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "toolkit_revision": "21f8041a2a11a13367f49a37e624ac51ab8c4481",
    "files": [
      {
        "path": "SOURCE_VERSION",
        "format": "text",
        "value": "package"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "value": "package",
        "package": "integration-tests",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "integration-tests-*.tar.gz",
        "format": "tar-text",
        "member": "integration-tests/SOURCE_VERSION",
        "value": "package"
      }
    ]
  },
  "fuzzing": {
    "toolkit_ref": "21a366f200f0371a10a6de7ad6ca263af230b842"
  },
  "toolkit_revision": "21f8041a2a11a13367f49a37e624ac51ab8c4481"
}
