# Dockerfile.test for integration testing
# Uses environment variables for MQTT connection

FROM python:3.14-slim@sha256:0741d101873c12ab927e6f8653feb8862b9bd58771177acb1b885b95141f91b4

WORKDIR /app
ENV MQTT_HOST=${MQTT_HOST:-mqtt-broker}
ENV MQTT_PORT=${MQTT_PORT:-1883}

COPY requirements-test-runner.txt ./
RUN pip install --no-cache-dir --only-binary :all: --require-hashes -r requirements-test-runner.txt && \
    groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser && \
    chown -R appuser:appgroup /app

COPY --chown=root:root --chmod=755 tests /app/tests
USER appuser
CMD ["pytest", "tests/", "-v", "--tb=short"]
