{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "description": "Generated locks are updated by pip-compile through their recorded source inputs; never edit the output pins independently.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "mock-battery/requirements.txt",
        "mock-dbus/requirements.txt",
        "mock-pv/requirements.txt",
        "requirements-test-runner.txt"
      ],
      "enabled": false
    },
    {
      "description": "Keep project dependencies and exact runner input pins together so both uv and hashed runner locks stay aligned.",
      "matchManagers": [
        "pep621",
        "pip-compile",
        "pip_requirements"
      ],
      "matchFileNames": [
        "pyproject.toml",
        "requirements.txt",
        "requirements-test-runner.in"
      ],
      "groupName": "Runner Python dependencies",
      "groupSlug": "runner-python",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-integration.txt",
      "mock-battery/requirements.txt",
      "mock-dbus/requirements.txt",
      "mock-pv/requirements.txt",
      "requirements-test-runner.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^mock\\-battery/requirements\\.txt$/",
      "/^mock\\-dbus/requirements\\.txt$/",
      "/^mock\\-pv/requirements\\.txt$/",
      "/^requirements\\-test\\-runner\\.txt$/",
      "/^\\.github/requirements\\-integration\\.txt$/"
    ]
  }
}
